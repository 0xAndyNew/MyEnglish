# ============================================================================
# Little English World & MyEnglish — Environment Configuration (.env.example)
# Copy this file to .env for local/staging/production overrides.
# Do NOT commit real secrets or API keys into version control.
# ============================================================================

# Server HTTP Port (default: 3001)
PORT=3001

# Environment mode: development | staging | production
NODE_ENV=development

# SQLite Database file path (default: ./data/myenglish.db)
SQLITE_DB_PATH=./data/myenglish.db

# Uploaded Media Storage Directory for Little English World CMS
LEW_MEDIA_DIR=./data/lew-media

# Uploaded Song Audio Directory
SONG_AUDIO_DIR=./data/song-audio

# Local Whisper Speech-to-Text Model Cache Directory
TRANSFORMERS_CACHE=./data/models

# Optional: Default Gemini API Key (can also be configured safely via Admin UI in SQLite app_settings)
GEMINI_API_KEY=
